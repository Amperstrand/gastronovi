{
  "name": "gastronovi",
  "version": "0.1.0",
  "description": "Read-only GastroNova self-ordering client. Menu reads behind the ALTCHA proof-of-work gate. No orders, no payment.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "gate": "node scripts/leak-scan.mjs . --history",
    "prepare": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  }
}
